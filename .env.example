# 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다.
#   cp .env.example .env.local && open -e .env.local
# .env.local 은 깃에 올라가지 않습니다. 값을 채팅창에 붙여넣지 마세요.

# ── 없으면 안 되는 것 ────────────────────────────────────────────
# platform.openai.com → API keys 에서 발급
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# developers.facebook.com 에서 스레드 앱을 만든 뒤 `node threads-login.mjs` 로 발급
# 토큰은 60일마다 다시 받아야 합니다
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── 없어도 도는 것 ───────────────────────────────────────────────
# 조회수와 등급을 보려면 필요합니다. 넣는 법은 docs/사용법.md §5-1
THREADS_COOKIE=

# 쿠팡파트너스 제휴 링크를 넣으려면 필요합니다. 없으면 링크 없이 글만 올립니다
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 영상을 같이 올리려면 필요합니다. 없으면 사진만 올라갑니다
# vercel.com → Storage → Blob 저장소를 만들면 나옵니다
BLOB_READ_WRITE_TOKEN=

# 스레드 앱 설정용 (threads-login.mjs 를 쓸 때만)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/
