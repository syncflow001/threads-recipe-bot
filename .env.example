# 열쇠 서식. 이 파일을 `.env.local` 로 베껴 값을 채운다.
# ⚠️ 값은 대시보드 「설정 → 열쇠」 칸에서 넣는 것이 쉽다. 파일을 직접 고쳐도 된다.
#
# 열쇠는 두 갈래다.
#   공용  — `.env.local` 에 둔다. 계정이 아니라 이 컴퓨터 주인의 것이다
#   계정 것 — `계정/<계정이름>/열쇠.env` 에 둔다. 계정을 만들면 이 서식에서 자동으로 만들어진다
#
# ⚠️ 공용 열쇠 사본을 계정 파일에 두지 마라. `node --env-file` 은 뒤에 오는 파일이 이기므로
#    그 계정만 딴 값을 쓰게 된다.

# ── 공용 (.env.local) ────────────────────────────────────────────

# 스레드 앱. developers.facebook.com → 내 앱 → 앱 만들기 → Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=

# 쿠팡 파트너스 (제휴 링크를 안 붙일 거면 비워 둔다)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 영상 올릴 자리. vercel.com → Storage → Blob (무료로 시작)
BLOB_READ_WRITE_TOKEN=

# 알림 받을 텔레그램 봇 (안 쓸 거면 비워 둔다)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 계정 것 (계정/<이름>/열쇠.env) ──────────────────────────────────

# 발행 토큰. 대시보드 「설정 → 자동발급」 을 누르면 저절로 채워진다. 60일마다 다시 받는다
THREADS_ACCESS_TOKEN=
# 토큰을 넣으면 스레드가 알려 준다. 사람이 넣지 않아도 된다
THREADS_USER_ID=
# 로그인 쿠키. 글을 걷고 조회수를 읽는 데 쓴다 (발행에는 토큰을 쓴다)
THREADS_COOKIE=
