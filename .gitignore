.DS_Store

# 새 대시보드 빌드 산출물과 제 의존성
dashboard/.next/
dashboard/node_modules/
dashboard/next-env.d.ts

# Next 가 build/dev 때마다 되살리는 안내 파일 — Claude Code 가 세션 지침으로 읽어
# 뿌리 CLAUDE.md 규율과 부딪힌다. archive/ 로 옮겼으니 다시 들어오지 못하게 막는다
dashboard/CLAUDE.md
dashboard/AGENTS.md

# 계정별 크롬 프로필 — 로그인 정보다. 절대 저장소에 넣지 않는다
크롬프로필/

# 의존성 설치 산출물
node_modules/

# 환경 변수 — 이 저장소는 쿠팡 API 키를 다룬다. 어느 디렉터리에 있든 커밋되면 안 된다
.env
.env.*
!.env.example

# Playwright MCP 조사 중 생기는 임시 산출물
.playwright-mcp/

# SDD 작업 공간 (git 미추적 스크래치)
.superpowers/

# Vercel CLI 가 만드는 프로젝트 연결 정보와 토큰
.vercel

# 베타 사용자에게 보낼 확장 압축 꾸러미 — 빌드 산출물
dist-package/

# understand-anything 이 만드는 코드 지도 — 커밋 대신 필요할 때 다시 만든다
.ua/

# 내려받은 스레드 미디어 — 남의 저작물이다. 커밋하지 않는다
media/

# 자동 발행 기록 — 계속 쌓인다. 커밋하지 않는다
logs/

# 계정 장부 — 사람마다 다르다
계정정보.json

# 설정 화면 문지기 열쇠 — 이 컴퓨터 것이다
.설정화면열쇠

# 급히 멈춘 표시 — 이 컴퓨터의 지금 상태다. 뿌리에만 둔다 (앞의 / 가 없으면
# src/멈춤.mjs 같은 소스 파일까지 이름만 보고 가려 버린다)
/멈춤
/멈춤.*

# 도달 기준선 — 이 계정들의 것이다
도달기준선.json
# 도달 이력 — 매일 아침 감시기가 쌓는다. 이 계정들의 것이다
도달이력.jsonl
보관함.json
보관함.*.json
logs/알림기록.json
올린요리.json
미디어지문.json
길들이기장부.json
# 열쇠 백업 — 쿠키·토큰이 그대로 들어 있다. 절대 저장소에 넣지 않는다 (2026-08-27 에 한 번 들어갔다)
.백업-*
활동장부.json
활동장부.json.옮김
